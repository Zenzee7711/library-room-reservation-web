# Copy to .env and fill in for your machine: cp .env.example .env

# HTTP
PORT=3000

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_room_reservation

# Signs the session cookie. Use a long random string in any deployed environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true only when the app is served over HTTPS
SESSION_COOKIE_SECURE=false
